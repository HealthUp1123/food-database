{
  "name": "food-database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Eigene Lebensmittel-Datenbank mit Such-API für einen Kalorientracker (Beispieldaten)",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "search": "node scripts/search-local.mjs",
    "test": "node scripts/validate.mjs && node scripts/test-worker.mjs",
    "dev": "cd api && npx wrangler dev",
    "deploy": "cd api && npx wrangler deploy"
  },
  "engines": { "node": ">=20.10" }
}
